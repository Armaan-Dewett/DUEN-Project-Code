import pigpio
import time
import os
import shutil
import glob
import subprocess
import cv2
import numpy as np
import imutils
import qrcode
from picamera2 import Picamera2
from datetime import datetime
from gpiozero import Button
from escpos.printer import Usb
from PIL import Image, ImageEnhance, ExifTags

# ============================================================
# PIN CONFIGURATION
# ============================================================

SERVO_PIN = 26          # GPIO pin for servo motor (updated from 17)
BUTTON_PIN = 17         # GPIO pin for the trigger button

# ============================================================
# FOLDER CONFIGURATION
# ============================================================

SAVE_DIR = os.path.expanduser("~/photos")
IMAGE_FOLDER = "imageprinter"
UNSTITCHED_FOLDER = os.path.join(IMAGE_FOLDER, "unstitchedImages")
STITCHED_OUTPUT = os.path.join(IMAGE_FOLDER, "stitchedOutputProcessed.png")
RAW_STITCHED_OUTPUT = os.path.join(IMAGE_FOLDER, "stitchedOutputRaw.png")
STITCH_RESIZE_WIDTH = 1200

# ============================================================
# SPEED + SHARPNESS SETTINGS
# ============================================================

# Lower = faster, but more chance of servo shake blur.
# Good range: 0.22 to 0.40
FAST_SERVO_WAIT = 0.28

# Lower exposure = less motion blur.
# 3000 us = 1/333 second
# If image is too dark, add more light first.
# Try 2000, 3000, 4000, or 5000.
EXPOSURE_TIME_US = 8000

# Higher gain brightens the image but adds noise.
# Try 4.0 to 8.0.
ANALOGUE_GAIN = 8.0

# Smaller image = faster capture and usually easier stitching.
# For max quality use 3280x2464.
# For faster, use 1920x1080 or 1640x1232.
IMAGE_WIDTH = 1920
IMAGE_HEIGHT = 1920

# Angles to capture
ANGLES_TO_CAPTURE = [270, 245, 220, 195, 170, 145, 120, 95, 70, 45, 20, 0]

MIN_PULSE = 500
MAX_PULSE = 2500
MAX_DEGREES = 270

# ============================================================
# PRINT / QR CONFIGURATION
# ============================================================

PRINTER_WIDTH_PX = 384  # Thermal printer paper width in pixels at 203 DPI

# 8mm spacing between photo and QR at 203 DPI:
# 203 DPI / 25.4 mm/inch = 7.99 px/mm → 8mm ≈ 64 px
QR_GAP_PX = 64

# QR code target width (centered within PRINTER_WIDTH_PX)
QR_TARGET_WIDTH = 260

# URL to encode in the QR code.
# Replace this with your Google Drive share link, a custom URL, etc.
# If left empty (""), the QR code is skipped entirely.
QR_URL = ""   # ← FILL IN YOUR URL HERE

# DUEN logo settings — printed at the very bottom of every receipt.
# Drop a PNG (transparent background OK, but black-on-white prints best on
# thermal paper) at LOGO_PATH. If the file is missing, the logo is silently
# skipped and the rest of the print still works.
LOGO_PATH        = os.path.expanduser("~/duen/duen_logo.png")
LOGO_TARGET_WIDTH = 240   # px — scale logo to this width, preserving aspect ratio
LOGO_GAP_PX       = 64    # 8mm gap above the logo (matches QR spacing)

# ============================================================
# SETUP
# ============================================================

os.makedirs(SAVE_DIR, exist_ok=True)

pi = pigpio.pi()
if not pi.connected:
    raise RuntimeError("Could not connect to pigpiod. Run: sudo pigpiod")

button = Button(BUTTON_PIN, pull_up=True, bounce_time=0.05)

camera = Picamera2()
config = camera.create_still_configuration(
    main={"size": (IMAGE_WIDTH, IMAGE_HEIGHT)}
)
camera.configure(config)
camera.start()
time.sleep(2)
print("Panorama photo booth ready! Press the button to start.")

# ============================================================
# SERVO HELPERS
# ============================================================

def angle_to_pulse(angle):
    angle = max(0, min(MAX_DEGREES, angle))
    pulse = MIN_PULSE + (angle / MAX_DEGREES) * (MAX_PULSE - MIN_PULSE)
    return int(pulse)


def move_servo(angle):
    pulse = angle_to_pulse(angle)
    print(f"Moving to {angle} degrees, pulsewidth {pulse}")
    pi.set_servo_pulsewidth(SERVO_PIN, pulse)


# ============================================================
# IMAGE CAPTURE
# ============================================================

def setup_image_folders():
    if os.path.exists(IMAGE_FOLDER):
        shutil.rmtree(IMAGE_FOLDER)
    os.makedirs(UNSTITCHED_FOLDER)


def take_picture(angle, index):
    filename = os.path.join(UNSTITCHED_FOLDER, f"{index:02d}_angle_{angle:03d}.jpg")
    print(f"Taking picture: {filename}")
    camera.capture_file(filename)
    time.sleep(0.05)
    return filename


# ============================================================
# PANORAMA STITCHING
# ============================================================

def extract_capture_index(path):
    filename = os.path.basename(path)
    return int(filename.split("_")[0])


def crop_only_outer_black(stitched_img):
    """
    Keeps all real panorama content.
    Only removes empty black border around the outside.
    """
    gray = cv2.cvtColor(stitched_img, cv2.COLOR_BGR2GRAY)
    ys, xs = np.where(gray > 0)

    if len(xs) == 0 or len(ys) == 0:
        print("No visible pixels found. Saving raw stitched image.")
        return stitched_img

    x1 = np.min(xs)
    x2 = np.max(xs)
    y1 = np.min(ys)
    y2 = np.max(ys)

    return stitched_img[y1:y2 + 1, x1:x2 + 1]


def stitch_images():
    image_paths = sorted(
        glob.glob(os.path.join(UNSTITCHED_FOLDER, "*.jpg")),
        key=extract_capture_index
    )

    images = []
    print("Images being stitched:")
    for image_path in image_paths:
        print(image_path)
        img = cv2.imread(image_path)
        if img is None:
            print("Could not read:", image_path)
            continue
        img_stitch = imutils.resize(img, width=STITCH_RESIZE_WIDTH)
        images.append(img_stitch)

    print(f"Loaded {len(images)} images for stitching")

    if len(images) < 2:
        raise ValueError("Need at least 2 images to stitch.")

    imageStitcher = cv2.Stitcher_create(cv2.Stitcher_PANORAMA)
    status, stitched_img = imageStitcher.stitch(images)

    if status == cv2.Stitcher_OK:
        print("Stitching complete.")

        # Save raw stitch first so you can check whether the ends are actually there.
        cv2.imwrite(RAW_STITCHED_OUTPUT, stitched_img)
        print(f"Saved raw stitched image to: {RAW_STITCHED_OUTPUT}")

        # Add small black border, then crop only the outside empty area.
        stitched_img = cv2.copyMakeBorder(
            stitched_img, 10, 10, 10, 10,
            cv2.BORDER_CONSTANT, (0, 0, 0)
        )

        cleaned_img = crop_only_outer_black(stitched_img)
        cv2.imwrite(STITCHED_OUTPUT, cleaned_img)
        print(f"Saved final stitched image to: {STITCHED_OUTPUT}")
        return True

    else:
        print("Stitching failed. Status code:", status)
        if status == cv2.Stitcher_ERR_NEED_MORE_IMGS:
            print("Reason: Need more images or not enough matching features.")
        elif status == cv2.Stitcher_ERR_HOMOGRAPHY_EST_FAIL:
            print("Reason: Homography estimation failed.")
        elif status == cv2.Stitcher_ERR_CAMERA_PARAMS_ADJUST_FAIL:
            print("Reason: Camera parameter adjustment failed.")
        return False


# ============================================================
# PRINT COMPOSITING HELPERS
# ============================================================

def make_qr_image(url, target_width=QR_TARGET_WIDTH):
    """
    Generates a QR code for `url` and returns it as a grayscale PIL Image
    scaled to target_width pixels square (centered later when composited).
    """
    qr = qrcode.QRCode(
        version=None,           # auto-size
        error_correction=qrcode.constants.ERROR_CORRECT_M,
        box_size=10,
        border=4,
    )
    qr.add_data(url)
    qr.make(fit=True)
    qr_img = qr.make_image(fill_color="black", back_color="white").convert("L")
    qr_img = qr_img.resize((target_width, target_width), Image.LANCZOS)
    return qr_img


def load_logo_image(path=LOGO_PATH, target_width=LOGO_TARGET_WIDTH, threshold=200):
    """
    Loads the DUEN logo from disk and prepares it for thermal printing:
        1. Composites onto a white background (handles transparent PNGs).
        2. Converts to grayscale.
        3. Thresholds to pure black/white — anything darker than `threshold`
           becomes solid black, everything else white. This makes the gold
           DUEN logo print as a clean silhouette instead of a faded gray blob.
        4. Scales to target_width preserving aspect ratio.

    Returns None if the file is missing or cannot be read; composite_print_image
    silently skips the logo block in that case.
    """
    if not os.path.exists(path):
        return None
    try:
        raw = Image.open(path)

        # Flatten transparency onto white so transparent pixels don't darken
        if raw.mode in ("RGBA", "LA") or (raw.mode == "P" and "transparency" in raw.info):
            bg = Image.new("RGB", raw.size, (255, 255, 255))
            rgba = raw.convert("RGBA")
            bg.paste(rgba, mask=rgba.split()[-1])
            raw = bg

        gray = raw.convert("L")

        # Pure-black/pure-white threshold — best for thermal output
        bw = gray.point(lambda px: 0 if px < threshold else 255, mode="L")

        ratio = target_width / bw.width
        new_size = (target_width, int(bw.height * ratio))
        return bw.resize(new_size, Image.LANCZOS)
    except Exception as e:
        print(f"Could not load logo at {path}: {e}")
        return None


def composite_print_image(photo_img, qr_url=None):
    """
    Takes a print-ready grayscale photo PIL Image (already 384px wide) and
    returns a new PIL Image stacked as:
        [photo]
        [8mm gap]
        [dashed line]
        [8mm gap]
        [QR code, centred]   ← only if qr_url provided
        [8mm gap]
        [DUEN logo, centred] ← only if LOGO_PATH file exists
    The QR and logo blocks are independent — either, both, or neither may be
    appended depending on what's available.
    """
    blocks = []   # list of PIL Images stacked top-to-bottom

    # Always start with the photo
    blocks.append(photo_img)

    gap_qr   = Image.new("L", (PRINTER_WIDTH_PX, QR_GAP_PX),   color=255)
    gap_logo = Image.new("L", (PRINTER_WIDTH_PX, LOGO_GAP_PX), color=255)

    # ── QR section ──
    if qr_url:
        qr_img = make_qr_image(qr_url)
        qr_canvas = Image.new("L", (PRINTER_WIDTH_PX, qr_img.height), color=255)
        qr_canvas.paste(qr_img, ((PRINTER_WIDTH_PX - qr_img.width) // 2, 0))
        blocks += [gap_qr, qr_canvas]

    # ── Logo section ──
    logo = load_logo_image()
    if logo is not None:
        logo_canvas = Image.new("L", (PRINTER_WIDTH_PX, logo.height), color=255)
        logo_canvas.paste(logo, ((PRINTER_WIDTH_PX - logo.width) // 2, 0))
        blocks += [gap_logo, logo_canvas]

    # Nothing extra to stack — return photo unchanged
    if len(blocks) == 1:
        return photo_img

    total_height = sum(b.height for b in blocks)
    combined = Image.new("L", (PRINTER_WIDTH_PX, total_height), color=255)
    y = 0
    for b in blocks:
        combined.paste(b, (0, y))
        y += b.height
    return combined


# ============================================================
# THERMAL PRINTING
# ============================================================

def process_and_print(filepath, qr_url=QR_URL):
    img = Image.open(filepath)

    # Strip EXIF orientation
    try:
        exif = img._getexif()
        if exif:
            for tag, value in exif.items():
                if ExifTags.TAGS.get(tag) == 'Orientation':
                    if value == 3:
                        img = img.rotate(180, expand=True)
                    elif value == 6:
                        img = img.rotate(270, expand=True)
                    elif value == 8:
                        img = img.rotate(90, expand=True)
                    break
    except Exception:
        pass

    # Convert to grayscale
    img = img.convert("L")

    # Brightness
    enhancer = ImageEnhance.Brightness(img)
    img = enhancer.enhance(1.0)

    # Contrast
    enhancer = ImageEnhance.Contrast(img)
    img = enhancer.enhance(1.5)

    # Sharpness
    enhancer = ImageEnhance.Sharpness(img)
    img = enhancer.enhance(1.5)

    # Rotate for landscape printing
    img = img.rotate(90, expand=True)

    # Resize to printer width
    width = PRINTER_WIDTH_PX
    ratio = width / img.width
    height = int(img.height * ratio)
    img = img.resize((width, height), Image.LANCZOS)

    # Composite QR below the photo (no-op if QR_URL is empty)
    img = composite_print_image(img, qr_url)

    # Save print-ready copy
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    temp_path = os.path.join(SAVE_DIR, f"panorama_{timestamp}.png")
    img.save(temp_path)
    print(f"Print-ready image size: {img.size}, saved to: {temp_path}")

    # Send to printer
    try:
        p = Usb(0x0485, 0x5741)
        p.hw('INIT')
        p.image(temp_path)
        p.text("\n")
        p.cut()
        print("Panorama printed successfully!")
    except Exception as e:
        print(f"Print failed: {e}")


# ============================================================
# MAIN FLOW — triggered by button press
# ============================================================

# Guard against double-triggers while a shot is in progress
is_running = False


def run_panorama_and_print():
    global is_running

    if is_running:
        print("Already running — ignoring button press.")
        return

    is_running = True
    print("\n--- Button pressed! Starting panorama capture ---")

    try:
        setup_image_folders()

        # Apply manual exposure settings
        camera.set_controls({
            "AeEnable": False,
            "ExposureTime": EXPOSURE_TIME_US,
            "AnalogueGain": ANALOGUE_GAIN,
            "AwbEnable": True
        })
        time.sleep(0.3)  # Let settings apply

        # Sweep and capture
        for index, angle in enumerate(ANGLES_TO_CAPTURE):
            move_servo(angle)
            time.sleep(FAST_SERVO_WAIT)
            take_picture(angle, index)

        # Flush images to disk
        print("Flushing image files to disk...")
        subprocess.run(["sync"])

        # Return servo to center
        move_servo(135)
        print("Servo returned to center (135 degrees)")

        # Stitch panorama
        success = stitch_images()

        # Print result
        if success and os.path.exists(STITCHED_OUTPUT):
            process_and_print(STITCHED_OUTPUT)
        else:
            print("Skipping print — stitching did not produce a valid output.")

    except Exception as e:
        print(f"Error during panorama capture: {e}")

    finally:
        is_running = False
        print("--- Ready for next shot ---\n")


button.when_pressed = run_panorama_and_print

# ============================================================
# KEEP ALIVE
# ============================================================

try:
    while True:
        time.sleep(0.1)
except KeyboardInterrupt:
    print("\nShutting down.")
    camera.stop()
    pi.set_servo_pulsewidth(SERVO_PIN, 0)
    pi.stop()
