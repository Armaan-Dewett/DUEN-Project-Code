        self.f_mono_md = tkfont.Font(family="Courier", size=11)
        self.f_mono_sm = tkfont.Font(family="Courier", size=9)
        self.f_sans_lg = tkfont.Font(family="DejaVu Sans", size=13, weight="bold")
